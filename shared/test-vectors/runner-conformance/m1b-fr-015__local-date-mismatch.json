{
  "id": "local-date-mismatch",
  "rule": "M1B-FR-015",
  "meta": {
    "tags": [
      "fictional-data"
    ],
    "conformance": {
      "outcome": "compare",
      "path": "/then/state/localDate/day"
    }
  },
  "given": {
    "clock": {
      "now": "2031-04-05T18:30:00Z"
    },
    "state": {},
    "timeZone": "America/Los_Angeles"
  },
  "when": {
    "op": "fixture.calendar",
    "args": {
      "value": {
        "localDate": {
          "year": 2031,
          "month": 4,
          "day": 5
        }
      }
    }
  },
  "then": {
    "state": {
      "localDate": {
        "year": 2031,
        "month": 4,
        "day": 6
      }
    }
  }
}
