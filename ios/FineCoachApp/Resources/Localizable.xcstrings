    "app.title": {
      "comment": "Application title",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精练教练"
          }
        }
      }
    },
    "storage.unavailable": {
      "comment": "Shown when protected local storage cannot be opened",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存储暂不可用"
          }
        }
      }
    },
    "exercise.catalog.unavailable": {
      "comment": "Shown when the placeholder exercise catalog cannot be seeded",
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作库暂不可用"
          }
        }
      }
    },
    "onboarding.kicker": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次打开 · 无账号"
          }
        }
      }
    },
    "onboarding.title": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "课堂记录留在这台手机"
          }
        }
      }
    },
    "onboarding.lead": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不注册、不登录。此刻也不会弹出通知、通讯录或其他系统权限。"
          }
        }
      }
    },
    "onboarding.local": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员资料与训练记录默认只保存在本机。卸载或丢失设备会一起丢失，后续可在设置里手动备份。"
          }
        }
      }
    },
    "onboarding.share": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享给学员时，由你主动挑选摘要内容。性别、伤病、电话、微信和教练私有备注不会进入分享。"
          }
        }
      }
    },
    "onboarding.operator": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学员本人不是使用者。他们不安装、不登录、也不在本模块里操作数据。"
          }
        }
      }
    },
    "onboarding.start": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始使用"
          }
        }
      }
    },
    "onboarding.skip": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
