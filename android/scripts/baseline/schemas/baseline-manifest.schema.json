{
  "$comment": "Source: /Users/liyongqiang/.agents/skills/ig-design-system/schemas/baseline-manifest.schema.json; copied 2026-11-17.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline-manifest.schema.json",
  "title": "Owner-approved screenshot baselines",
  "description": "Only the owner approves entries. Every entry carries the hash, the approval date and the decision id; scripts/baseline/baseline-check.mjs enforces it.",
  "type": "object",
  "required": [
    "version",
    "algorithm",
    "screens"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "description": "core screens only"
    },
    "environment": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/entry"
      },
      "description": "one or two component PNGs that only prove the rendering environment has not changed"
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "png",
        "sha256",
        "approvedAt",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "png": {
          "type": "string",
          "description": "baseline PNG path, relative to the manifest"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{12,64}$",
          "description": "full hash or a prefix of at least 12 hex digits"
        },
        "design": {
          "type": "string",
          "description": "approved design PNG, relative to the manifest; used by the compare page"
        },
        "fixture": {
          "type": "string"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "scale": {
              "type": "number"
            }
          }
        },
        "approvedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "description": "id in the project's decision log"
        }
      }
    }
  }
}
